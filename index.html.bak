<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tower — VR Workshop</title>
  <link rel="icon" href="data:,">

  <!-- A-Frame core -->
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>

  <!-- Physics (c-frame fork, актуальный для A-Frame 1.5) -->
  <script src="https://cdn.jsdelivr.net/gh/c-frame/aframe-physics-system@v4.2.2/dist/aframe-physics-system.min.js"></script>

  <!-- super-hands для хватания объектов -->
  <script src="https://cdn.jsdelivr.net/gh/c-frame/aframe-super-hands-component@3.0.4/dist/super-hands.min.js"></script>

  <!-- Стили -->
  <link rel="stylesheet" href="css/style.css" />

  <!-- Конфиг и логика (defer = выполнятся после парсинга HTML) -->
  <script src="js/config.js" defer></script>
  <script src="js/main.js" defer></script>
</head>

<body>
    <a-scene background="color: #1a1a1a" physics="driver: local; gravity: -9.8; debug: false">

    <!-- ====== АССЕТЫ ====== -->
    <a-assets>
      <a-asset-item id="leftHandModel" src="assets/models/leftHandLow.glb"></a-asset-item>
      <a-asset-item id="rightHandModel" src="assets/models/rightHandLow.glb"></a-asset-item>
    </a-assets>

    <!-- ====== КОМНАТА (куб 3×3×3 м) ====== -->

    <!-- Пол -->
    <a-plane position="0 0 0" rotation="-90 0 0" width="3" height="3" color="#8a8580" static-body></a-plane>
    <!-- Потолок -->
    <a-plane position="0 3 0" rotation="90 0 0" width="3" height="3" color="#f0ede5"></a-plane>
    <!-- Стена СЕВЕР -->
    <a-plane position="0 1.5 -1.5" width="3" height="3" color="#d4cfc0"></a-plane>
    <!-- Стена ЮГ -->
    <a-plane position="0 1.5 1.5" rotation="0 180 0" width="3" height="3" color="#d4cfc0"></a-plane>
    <!-- Стена ЗАПАД -->
    <a-plane position="-1.5 1.5 0" rotation="0 90 0" width="3" height="3" color="#d4cfc0"></a-plane>
    <!-- Стена ВОСТОК -->
    <a-plane position="1.5 1.5 0" rotation="0 -90 0" width="3" height="3" color="#d4cfc0"></a-plane>


    <!-- ====== ПЬЕДЕСТАЛ ====== -->
    <a-cylinder
      position="0 0.5 0"
      radius="0.3"
      height="1"
      color="#3a3a3a"
      static-body>
    </a-cylinder>


    <!-- ====== ТЕСТОВЫЙ КУБИК ====== -->
    <a-box
      id="test-cube"
      class="grabbable"
      position="0 2.5 0"
      width="0.1"
      height="0.1"
      depth="0.1"
      color="#e74c3c"
      dynamic-body="mass: 1"
      grabbable>
    </a-box>


    <!-- ====== ИГРОК ====== -->
    <a-entity id="player" position="0 0 1">
      <a-camera position="0 1.6 0" look-controls wasd-controls></a-camera>

      <!-- VR-контроллеры рук (Quest 3) — дети rig'а игрока -->
      <a-entity id="leftHand"
                hand-controls="hand: left; handModelStyle: lowPoly; color: #ffffff"
                gltf-model="#leftHandModel"
                sphere-collider="objects: .grabbable; radius: 0.1"
                super-hands="grabStartButtons: gripdown, triggerdown; grabEndButtons: gripup, triggerup">
        <!-- ВРЕМЕННЫЙ маркер коллайдера для отладки -->
        <a-sphere radius="0.1" color="#00ff00" opacity="0.3" material="transparent: true"></a-sphere>
      </a-entity>

      <a-entity id="rightHand"
                hand-controls="hand: right; handModelStyle: lowPoly; color: #ffffff"
                gltf-model="#rightHandModel"
                sphere-collider="objects: .grabbable; radius: 0.1"
                super-hands="grabStartButtons: gripdown, triggerdown; grabEndButtons: gripup, triggerup">
        <a-sphere radius="0.1" color="#00ff00" opacity="0.3" material="transparent: true"></a-sphere>
      </a-entity>
    </a-entity>

  </a-scene>
</body>
</html>